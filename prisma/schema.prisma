generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum AnimalStatus {
  perdido
  encontrado
  en_calle
  ayudado
  rescatado
}

enum AnimalType {
  perro
  gato
  otro
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  avatarUrl    String?
  phone        String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reports Report[]

  @@map("users")
}

model Report {
  id          String       @id @default(uuid())
  name        String // nombre del animal
  type        AnimalType
  status      AnimalStatus @default(perdido)
  zone        String
  address     String?
  date        DateTime     @default(now())
  description String?
  breed       String?
  color       String?
  size        String?

  // datos de contacto (se copian del user al crear, pero pueden variar)
  contactName String
  phone       String
  email       String

  mapLat Float?
  mapLng Float?

  images ReportImage[]

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([zone])
  @@index([type])
  @@map("reports")
}

model ReportImage {
  id       String @id @default(uuid())
  url      String
  order    Int    @default(0)
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId String

  @@map("report_images")
}