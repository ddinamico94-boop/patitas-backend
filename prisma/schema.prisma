generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum AnimalStatus {
  perdido
  encontrado
  en_calle
  ayudado
  rescatado
}

enum AnimalType {
  perro
  gato
  otro
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  avatarUrl    String?
  phone        String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Recuperación de contraseña
  resetPasswordCodeHash  String?
  resetPasswordExpiresAt DateTime?

  reports Report[]

  // Conversaciones donde este usuario es quien hizo el reporte
  conversationsAsReporter Conversation[] @relation("ReporterConversations")
  // Conversaciones donde este usuario es quien quiere ayudar
  conversationsAsHelper   Conversation[] @relation("HelperConversations")
  messages                Message[]

  @@map("users")
}

model Report {
  id          String       @id @default(uuid())
  name        String // nombre del animal
  type        AnimalType
  status      AnimalStatus @default(perdido)
  zone        String
  address     String?
  date        DateTime     @default(now())
  description String?
  breed       String?
  color       String?
  size        String?

  // datos de contacto (se copian del user al crear, pero pueden variar)
  contactName String
  phone       String
  email       String

  mapLat Float?
  mapLng Float?

  images ReportImage[]

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([zone])
  @@index([type])
  @@map("reports")
}

model ReportImage {
  id       String @id @default(uuid())
  url      String
  order    Int    @default(0)
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId String

  @@map("report_images")
}

// Un chat privado 1 a 1 por reporte: entre quien reportó y una persona
// puntual que quiere ayudar. Cada persona interesada tiene su propia
// conversación (no se mezclan entre sí).
model Conversation {
  id String @id @default(uuid())

  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  reporterId String
  reporter   User   @relation("ReporterConversations", fields: [reporterId], references: [id], onDelete: Cascade)

  helperId String
  helper   User   @relation("HelperConversations", fields: [helperId], references: [id], onDelete: Cascade)

  messages Message[]

  // Hasta qué momento leyó cada uno de los dos participantes. Con esto
  // calculamos el contador de "no leídos" tipo WhatsApp, por separado
  // para cada persona (nunca se mezcla entre conversaciones ni usuarios).
  reporterLastReadAt DateTime?
  helperLastReadAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un mismo helper no puede tener 2 conversaciones para el mismo reporte
  @@unique([reportId, helperId])
  @@index([reporterId])
  @@index([helperId])
  @@map("conversations")
}

model Message {
  id String @id @default(uuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  content String

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@map("messages")
}
